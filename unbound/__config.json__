{
  "name": "Unbound DNS Server",
  "version": "1.0.0",
  "slug": "unbound_dns",
  "description": "Ein Home Assistant OS Add-on mit Unbound als DNS-Server.",
  "startup": "system",
  "boot": "auto",
  "init": "true",
  "arch": ["aarch64", "amd64", "armv7"],
  "ports": {"53/udp": 53, "53/tcp": 53},
  "schema": {},
  "map": ["config:rw"]
}
